# All core queries are local.  Keep real credentials out of this file.

# Optional paths. Relative paths are resolved from the demo directory.
APP_DATA_DIR=data
BGE_M3_MODEL_PATH=models/bge-m3
RERANK_MODEL_PATH=models/bge-reranker-v2-m3

# Use cuda for the verified RTX 3050 setup.  Set cpu on a CPU-only machine.
RERANK_DEVICE=cuda

# Optional persistent session secret (at least 32 characters). Leave blank to
# generate a high-entropy, process-local secret at each server start.
DEMO_SESSION_SECRET=
