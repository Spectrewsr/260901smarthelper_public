# Optional: enable the evidence-grounded LLM rewrite when these values are set.
# Leave all values blank to use the fully local, deterministic report fallback.
OPENCODEGO_API_KEY=
OPENCODEGO_BASE_URL=
OPENCODEGO_MODEL=deepseek-v4-flash
# Optional alternative to OPENCODEGO_API_KEY. Point this only to a local file
# containing the key (or an OPENCODEGO_API_KEY=... line); the backend reads it
# at startup and never exposes it to the browser.
OPENCODEGO_KEY_FILE=

# Generic aliases take precedence when supplied. This makes the provider swappable.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=45

# Optional path override. Relative paths are resolved from the demo directory.
APP_DATA_DIR=data
